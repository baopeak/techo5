#!/bin/sh
# All application runtime work is local to the Echo. Never mounts host /data into the chroot.
set -eu
case "${1:-}" in web|youtube) ;; *) exit 64;; esac
[ "$#" -eq 1 ] || exit 64
R=/data/techo5-apps/runtime
[ -x "$R/usr/bin/firefox-esr" ] && [ -x "$R/usr/bin/python3" ] || exit 69
umask 077
mkdir -p /data/techo5-apps/logs "$R/dev" "$R/proc" "$R/sys" "$R/tmp" "$R/run" "$R/dev/input" "$R/dev/shm"
chmod 1777 "$R/tmp"
# Read-only firmware is not modified. These transient mounts vanish at reboot.
if ! mountpoint -q "$R/dev"; then mount -t tmpfs -o mode=755 tmpfs "$R/dev"; fi
mkdir -p "$R/dev/input" "$R/dev/shm"
chmod 1777 "$R/dev/shm"
node() { [ -e "$R/dev/$1" ] || mknod -m "$2" "$R/dev/$1" c "$3" "$4"; }
node null 666 1 3
node zero 666 1 5
node random 666 1 8
node urandom 666 1 9
node tty 666 5 0
node fb0 600 29 0
node input/event2 600 13 66
if ! mountpoint -q "$R/proc"; then mount -t proc -o nosuid,nodev,noexec,hidepid=2 proc "$R/proc"; fi
if ! mountpoint -q "$R/sys"; then mount --bind /sys "$R/sys"; fi
# libinput requires udev's classification; the exact touchscreen node was verified on crown.
mkdir -p "$R/run/udev/data"
printf 'E:ID_INPUT=1\nE:ID_INPUT_TOUCHSCREEN=1\n' > "$R/run/udev/data/c13:66"
cp /etc/resolv.conf "$R/etc/resolv.conf"
chmod 644 "$R/etc/resolv.conf"
exec 2>>/data/techo5-apps/logs/session.log
exec chroot "$R" /usr/bin/python3 /usr/local/share/techo5-apps/session.py "$1"
